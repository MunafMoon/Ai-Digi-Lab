{
  "name": "taskpilot-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspaces",
    "prisma:generate": "npx prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema server/prisma/schema.prisma",
    "seed": "npm run seed --workspace server"
  }
}
